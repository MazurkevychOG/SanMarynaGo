{
  "name": "maps",
  "version": "1.0.0",
  "private": true,
  "description": "MyMaps — статичний сайт із каталогом місць (data/) та скриптами для їх створення й перевірки",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "add-place": "node scripts/add-place.mjs",
    "update-place": "node scripts/update-place.mjs",
    "build-index": "node scripts/build-index.mjs",
    "validate": "node scripts/validate.mjs",
    "fill-near": "node scripts/fill-near.mjs",
    "check": "node scripts/build-index.mjs --check && node scripts/validate.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
